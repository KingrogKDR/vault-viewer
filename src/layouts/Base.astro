---
// The shared page layout: header, file tree sidebar, and the page's content
// in the default slot. Pages put their own <main id="content"> in the slot
// (the skip link points at it).
//
// On narrow screens the tree hides behind the header's "Files" button. The
// button is a label for a checkbox that precedes the tree, so CSS alone
// (`:checked ~ .file-tree`) shows it: no JavaScript.
import { loadVault } from "../lib/vault";
import { vaultFileTree } from "../lib/folders";
import FileTree from "../components/FileTree.astro";
// The pastel journal theme and fonts, shared with the shared page layout (Shared.astro).
import "../styles/notebook.css";

interface Props {
  /** The page's <title>. */
  title: string;
  /** Vault path of the vault file this page shows; omit on pages that show none. */
  current?: string;
  /** Vault path of the folder a folder page shows; omit on other pages. */
  currentFolder?: string;
}

const { title, current, currentFolder } = Astro.props;
const tree = vaultFileTree((await loadVault()).files);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <input type="checkbox" id="file-tree-toggle" class="file-tree-toggle" aria-controls="file-tree" />
    <header class="site-header">
      <label for="file-tree-toggle" class="button file-tree-button">
        <svg class="button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        Files
      </label>
      <a class="site-name" href="/">Vault</a>
    </header>
    <nav class="file-tree" id="file-tree" aria-label="Files">
      <FileTree entries={tree} current={current} currentFolder={currentFolder} />
    </nav>
    <slot />
  </body>
</html>
