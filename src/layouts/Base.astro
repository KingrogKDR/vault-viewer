---
// The shared page layout: header, file tree sidebar, and the page's content
// in the default slot. Pages put their own <main> in the slot.
//
// On narrow screens the tree hides behind the header's "Files" button. The
// button is a label for a checkbox that precedes the tree, so CSS alone
// (`:checked ~ .file-tree`) shows it: no JavaScript.
import { loadVault } from "../lib/vault";
import { buildFileTree } from "../lib/file-tree";
import FileTree from "../components/FileTree.astro";

interface Props {
  /** The page's <title>. */
  title: string;
  /** Vault path of the vault file this page shows; omit on pages that show none. */
  current?: string;
}

const { title, current } = Astro.props;
const tree = buildFileTree((await loadVault()).files);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <input type="checkbox" id="file-tree-toggle" class="file-tree-toggle" aria-controls="file-tree" />
    <header class="site-header">
      <label for="file-tree-toggle" class="file-tree-button">Files</label>
      <a class="site-name" href="/">Vault</a>
    </header>
    <nav class="file-tree" id="file-tree" aria-label="Files">
      <FileTree entries={tree} current={current} />
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fdfdfc;
    --fg: #1f2328;
    --muted: #59636e;
    --line: #d1d9e0;
    --accent: #0969da;
    --current-bg: #ddf4ff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117;
      --fg: #e6edf3;
      --muted: #9198a1;
      --line: #3d444d;
      --accent: #4493f8;
      --current-bg: #102a4c;
    }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 1rem/1.6 system-ui, sans-serif;
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: "header header" "tree main";
    min-height: 100vh;
  }
  a { color: var(--accent); }

  .site-header {
    grid-area: header;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .site-name { color: inherit; font-weight: 600; text-decoration: none; }

  body > main { grid-area: main; padding: 1rem 2rem; max-width: 48rem; }

  /* The checkbox stays focusable for keyboards but is visually hidden. */
  .file-tree-toggle { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .file-tree-button { display: none; cursor: pointer; padding: 0.25rem 0.75rem; border: 1px solid var(--line); border-radius: 0.375rem; }
  .file-tree-toggle:focus-visible ~ .site-header .file-tree-button { outline: 2px solid var(--accent); outline-offset: 2px; }

  .file-tree {
    grid-area: tree;
    padding: 0.75rem 0.5rem;
    border-right: 1px solid var(--line);
    overflow-y: auto;
    font-size: 0.9rem;
  }
  .file-tree ul { list-style: none; margin: 0; padding-left: 0.9rem; }
  .file-tree > ul { padding-left: 0; }
  .file-tree summary { cursor: pointer; color: var(--muted); }
  .file-tree a { display: block; padding: 0.05rem 0.4rem; border-radius: 0.25rem; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .file-tree a:hover { text-decoration: underline; }
  .file-tree a[aria-current="page"] { background: var(--current-bg); font-weight: 600; }

  @media (max-width: 48rem) {
    body { grid-template-columns: minmax(0, 1fr); grid-template-areas: "header" "tree" "main"; grid-template-rows: auto auto 1fr; }
    body > main { padding: 1rem; }
    .file-tree-button { display: inline-block; }
    .file-tree { display: none; border-right: 0; border-bottom: 1px solid var(--line); }
    #file-tree-toggle:checked ~ .file-tree { display: block; }
  }
</style>
