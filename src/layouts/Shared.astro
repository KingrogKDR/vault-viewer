---
// The layout of a shared page (ADR-0006): the notebook sheet and the note,
// nothing else. A visitor is outside Access, so there is no header, no
// "Vault" link (`/` is behind the Access login), no file tree and no
// download. The theme and fonts are Base's (styles/notebook.css).
import "../styles/notebook.css";

interface Props {
  /** The page's <title>: the shared note's title. */
  title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- _headers sends Referrer-Policy too; this keeps the token out of Referer wherever the page is served. -->
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
  </head>
  <body class="shared-page">
    <main id="content">
      <slot />
    </main>
  </body>
</html>
