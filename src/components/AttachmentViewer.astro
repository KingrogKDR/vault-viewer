---
// The viewer for an attachment: its vault path and size, with images shown
// inline (the page's download button is in PageActions). Later kinds (pdf, video, ...) add their viewers here.
import type { Attachment } from "../lib/vault";
import { rawUrlFor } from "../lib/slug";

interface Props {
  file: Attachment;
  /** The attachment's file name, shown as the page heading. */
  title: string;
}

const { file, title } = Astro.props;
const rawUrl = rawUrlFor(file.path);

/** Size for people: bytes below 1 KB, else KB/MB/GB (1024-based) to one decimal, `.0` dropped. */
function humanSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} ${bytes === 1 ? "byte" : "bytes"}`;
  const units = ["KB", "MB", "GB", "TB"];
  let value = bytes / 1024;
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit++;
  }
  return `${value.toFixed(1).replace(/\.0$/, "")} ${units[unit]}`;
}
---
<article class="attachment">
  <h1>{title}</h1>
  {file.kind === "image" && (
    <figure class="attachment-figure">
      <img class="attachment-image" src={rawUrl} alt={title} />
    </figure>
  )}
  <dl class="attachment-facts">
    <dt>Path</dt>
    <dd><code>{file.path}</code></dd>
    <dt>Size</dt>
    <dd>{humanSize(file.size)}</dd>
  </dl>
</article>

<style>
  /* Colours come only from Base's variables. */
  .attachment { container-type: inline-size; }
  /* The image is taped onto the sheet like a photo. */
  .attachment-figure {
    position: relative;
    inline-size: fit-content;
    max-inline-size: 100%;
    margin: var(--line-h) auto;
    padding: 0.625rem 0.625rem 1.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    box-shadow: 0 1px 2px var(--shadow), 0 12px 24px -14px var(--shadow);
  }
  .attachment-figure::before {
    content: "";
    position: absolute;
    inset-block-start: -0.75rem;
    inset-inline-start: 50%;
    inline-size: 6rem;
    block-size: 1.5rem;
    translate: -50% 0;
    rotate: -2deg;
    background: var(--highlight);
    opacity: 0.65;
  }
  .attachment-image {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
  }
  /* The facts read like a shadcn card on the sheet. */
  .attachment-facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .attachment-facts dt {
    font-weight: 600;
    color: var(--muted-foreground);
  }
  .attachment-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  @container (max-width: 24rem) {
    .attachment-facts { grid-template-columns: 1fr; gap: 0; }
    .attachment-facts dd + dt { margin-block-start: 0.5rem; }
  }
</style>
