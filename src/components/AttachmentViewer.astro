---
// The viewer for an attachment: its vault path and size, with images shown
// inline (the page's download button is in PageActions). Later kinds (pdf, video, ...) add their viewers here.
import type { Attachment } from "../lib/vault";
import { rawUrlFor } from "../lib/slug";

interface Props {
  file: Attachment;
  /** The attachment's file name, shown as the page heading. */
  title: string;
}

const { file, title } = Astro.props;
const rawUrl = rawUrlFor(file.path);

/** Size for people: bytes below 1 KB, else KB/MB/GB (1024-based) to one decimal, `.0` dropped. */
function humanSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} ${bytes === 1 ? "byte" : "bytes"}`;
  const units = ["KB", "MB", "GB", "TB"];
  let value = bytes / 1024;
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit++;
  }
  return `${value.toFixed(1).replace(/\.0$/, "")} ${units[unit]}`;
}
---
<article class="attachment">
  <h1>{title}</h1>
  {file.kind === "image" && (
    <figure class="attachment-figure">
      <img class="attachment-image" src={rawUrl} alt={title} />
    </figure>
  )}
  <dl class="attachment-facts">
    <dt>Path</dt>
    <dd><code>{file.path}</code></dd>
    <dt>Size</dt>
    <dd>{humanSize(file.size)}</dd>
  </dl>
</article>

<style>
  /* Colours come only from Base's variables. */
  .attachment { container-type: inline-size; }
  /* The image is taped into the journal like a photo: two pastel corners. */
  .attachment-figure {
    position: relative;
    inline-size: fit-content;
    max-inline-size: 100%;
    margin: 2rem auto;
    padding: 0.625rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 2px);
    box-shadow: 0 1px 2px var(--shadow), 0 14px 28px -18px var(--shadow);
  }
  .attachment-figure::before,
  .attachment-figure::after {
    content: "";
    position: absolute;
    inline-size: 4.5rem;
    block-size: 1.25rem;
    background: var(--pastel-4);
    opacity: 0.85;
    pointer-events: none;
  }
  .attachment-figure::before { inset-block-start: 0.25rem; inset-inline-start: -1.25rem; rotate: -38deg; }
  .attachment-figure::after { inset-block-end: 0.25rem; inset-inline-end: -1.25rem; rotate: -38deg; background: var(--pastel-2); }
  .attachment-image {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    border-radius: calc(var(--radius) - 6px);
  }
  /* The facts, as a shadcn card. */
  .attachment-facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.375rem 1.25rem;
    margin: 0;
    padding: 0.875rem 1.125rem;
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .attachment-facts dt {
    font-weight: 600;
    color: var(--muted-foreground);
  }
  .attachment-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  @container (max-width: 24rem) {
    .attachment-facts { grid-template-columns: 1fr; gap: 0; }
    .attachment-facts dd + dt { margin-block-start: 0.5rem; }
  }
  @media (forced-colors: active) {
    .attachment-figure::before, .attachment-figure::after { display: none; }
  }
  @media print {
    .attachment-figure { box-shadow: none; }
    .attachment-figure::before, .attachment-figure::after { display: none; }
  }
</style>
