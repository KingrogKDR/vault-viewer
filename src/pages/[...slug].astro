---
import { readFile } from "node:fs/promises";
import { readVault, vaultDirFromEnv, type VaultFile } from "../lib/vault";
import { renderNote } from "../lib/render-note";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const vault = await readVault(vaultDirFromEnv());
  return vault.files.map((file) => ({ params: { slug: file.slug }, props: { file } }));
}

const { file } = Astro.props as { file: VaultFile };
const html = await renderNote(await readFile(file.absolutePath, "utf8"));
---
<Base title={file.path} current={file.path}>
  <main><article class="note" set:html={html} /></main>
</Base>
